generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  FARMER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(FARMER)
  phone     String?
  avatar         String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  filedTickets   SupportTicket[] @relation("FiledTickets")
  ticketMessages TicketMessage[] @relation("TicketMessages")
  teamMessages   TeamMessage[]   @relation("TeamMessages")
  farms          Farm[]          @relation("UserFarms")
  chatMessages   ChatMessage[]   @relation("UserChats")
  loginSessions  LoginSession[]
}

model LoginSession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique
  os          String
  browser     String
  ip          String
  location    String
  lastActive  DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Farm {
  id          String   @id @default(uuid())
  name        String
  location    String
  coordinates Json?    // { lat: number, lng: number }
  totalArea   Float?   // Hectares
  image       String?  @db.Text // Avatar/profile image URL
  manualMetrics Json?    // { milk: string, yield: string, prevMilk: string, prevYield: string }
  soilHistory Json?    // Array of { date: string, value: number }
  ownerId     String
  owner       User     @relation("UserFarms", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  chatMessages ChatMessage[] @relation("FarmChats")
  crops        Crop[]        @relation("FarmCrops")
  animals      Animal[]      @relation("FarmAnimals")
}

model Crop {
  id           String   @id @default(uuid())
  name         String
  type         String
  fieldId      String
  plantingDate String
  healthScore  Int
  ndvi         Float
  soilMoisture Int
  status       String   // "HEALTHY", "WARNING", "CRITICAL"
  alerts       String[] // Array of alert strings
  lastScanUrl  String?  @db.Text
  history      Json?    // Array of { date: string, ndvi: number }
  insights     Json?    // Object with various crop insights
  location     Json?    // { lat: number, lng: number }
  farmId       String
  farm         Farm     @relation("FarmCrops", fields: [farmId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Animal {
  id              String   @id @default(uuid())
  species         String
  breed           String
  tagId           String
  ageMonths       Int
  weightKg        Float
  temperature     Float
  activityLevel   String
  healthScore     Int
  status          String   // "HEALTHY", "WARNING", "CRITICAL"
  lastCheckup     String
  imageUrl        String?  @db.Text
  location        Json?    // { lat: number, lng: number }
  locationHistory Json?    // Array of { lat: number, lng: number, timestamp: number }
  farmId          String
  farm            Farm     @relation("FarmAnimals", fields: [farmId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserChats", fields: [userId], references: [id], onDelete: Cascade)
  farmId    String?
  farm      Farm?    @relation("FarmChats", fields: [farmId], references: [id], onDelete: Cascade)
  role      String   // "user", "model", "system"
  text      String   @db.Text
  createdAt DateTime @default(now())
}

enum TicketStatus {
  OPEN
  ESCALATED
  RESOLVED
}

model SupportTicket {
  id          String          @id @default(uuid())
  farmerId    String
  farmer      User            @relation("FiledTickets", fields: [farmerId], references: [id])
  subject     String
  status      TicketStatus    @default(OPEN)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  messages    TicketMessage[]
}

model TicketMessage {
  id          String        @id @default(uuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id])
  senderId    String
  sender      User          @relation("TicketMessages", fields: [senderId], references: [id])
  text        String        @db.Text
  createdAt   DateTime      @default(now())
}

model TeamMessage {
  id          String   @id @default(uuid())
  senderId    String
  sender      User     @relation("TeamMessages", fields: [senderId], references: [id])
  text        String   @db.Text
  createdAt   DateTime @default(now())
}
